:root{
  --pink:#ff5fa2; --pink-dark:#d63384; --pink-tint:#ffe0ec;
  --him:#1fb5c9; --him-dark:#0b8fa3; --him-tint:#d7f3f7;
  --sun:#ffa62b; --sun-dark:#d97f00; --sun-tint:#fff0d6;
  --soft:#f1e7e1; --softer:#fffaf5;
  --ink:#231f20; --muted:#74686c; --white:#fff; --green:#25d366;
